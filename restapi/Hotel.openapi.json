{
  "openapi": "3.0.3",
  "info": {
    "title": "Boutique Hotel Technikum – Booking API",
    "description": "REST API für die Buchungs-App des Hotel Technikum. Gäste können Hotelzimmer durchsuchen, Verfügbarkeit prüfen und Zimmer buchen.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Rooms",
      "description": "Hotelzimmer durchsuchen und Details abrufen (U2)"
    },
    {
      "name": "Availability",
      "description": "Zimmerverfügbarkeit prüfen (U3)"
    },
    {
      "name": "Bookings",
      "description": "Buchungen erstellen, abrufen und stornieren (U4, U5)"
    }
  ],
  "paths": {
    "/rooms": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Paginierte Zimmerliste",
        "description": "Gibt eine paginierte Liste aller Hotelzimmer zurück.\n\nWenn `checkIn` und `checkOut` angegeben werden, enthält jedes Zimmer direkt seinen Verfügbarkeitsstatus und den Gesamtpreis – so wird ein separater Availability-Request pro Zimmer vermieden.",
        "operationId": "getRooms",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Seitennummer (0-basiert)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Anzahl Zimmer pro Seite",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1
            }
          },
          {
            "name": "checkIn",
            "in": "query",
            "description": "Anreisedatum (Format: YYYY-MM-DD). Wenn angegeben, muss auch checkOut angegeben werden.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-01"
            }
          },
          {
            "name": "checkOut",
            "in": "query",
            "description": "Abreisedatum (Format: YYYY-MM-DD). Wenn angegeben, muss auch checkIn angegeben werden.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-05"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolgreiche Anfrage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomPage"
                },
                "examples": {
                  "withoutAvailability": {
                    "summary": "Ohne Datumsfilter",
                    "value": {
                      "content": [
                        {
                          "id": 1,
                          "title": "Deluxe Suite",
                          "description": "Geräumige Suite mit Balkon und Bergblick.",
                          "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                          "pricePerNight": 149.0,
                          "extras": [
                            {
                              "id": 1,
                              "name": "WiFi",
                              "icon": "wifi"
                            },
                            {
                              "id": 2,
                              "name": "Minibar",
                              "icon": "cup-hot"
                            }
                          ],
                          "availability": null
                        }
                      ],
                      "totalElements": 12,
                      "totalPages": 3,
                      "currentPage": 0,
                      "hasNextPage": true,
                      "hasPreviousPage": false
                    }
                  },
                  "withAvailability": {
                    "summary": "Mit Datumsfilter",
                    "value": {
                      "content": [
                        {
                          "id": 1,
                          "title": "Deluxe Suite",
                          "description": "Geräumige Suite mit Balkon und Bergblick.",
                          "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                          "pricePerNight": 149.0,
                          "extras": [
                            {
                              "id": 1,
                              "name": "WiFi",
                              "icon": "wifi"
                            }
                          ],
                          "availability": {
                            "available": true,
                            "nights": 4,
                            "totalPrice": 596.0
                          }
                        }
                      ],
                      "totalElements": 12,
                      "totalPages": 3,
                      "currentPage": 0,
                      "hasNextPage": true,
                      "hasPreviousPage": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rooms/{id}": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Zimmerdetails",
        "description": "Gibt die Details eines einzelnen Zimmers zurück.",
        "operationId": "getRoomById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID des Hotelzimmers",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Zimmer gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                },
                "example": {
                  "id": 1,
                  "title": "Deluxe Suite",
                  "description": "Geräumige Suite mit Balkon und Bergblick.",
                  "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                  "pricePerNight": 149.0,
                  "extras": [
                    {
                      "id": 1,
                      "name": "WiFi",
                      "icon": "wifi"
                    },
                    {
                      "id": 2,
                      "name": "Minibar",
                      "icon": "cup-hot"
                    },
                    {
                      "id": 3,
                      "name": "Balkon",
                      "icon": "door-open"
                    }
                  ],
                  "availability": null
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rooms/{id}/availability": {
      "get": {
        "tags": [
          "Availability"
        ],
        "summary": "Verfügbarkeit prüfen",
        "description": "Prüft, ob ein bestimmtes Zimmer im gewünschten Zeitraum verfügbar ist.\n\n**Validierungsregeln:**\n- `checkIn` darf nicht in der Vergangenheit liegen\n- `checkOut` muss nach `checkIn` liegen\n- Maximaler Buchungszeitraum: 30 Nächte",
        "operationId": "checkRoomAvailability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID des Hotelzimmers",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "checkIn",
            "in": "query",
            "description": "Anreisedatum (Format: YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-01"
            }
          },
          {
            "name": "checkOut",
            "in": "query",
            "description": "Abreisedatum (Format: YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-05"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verfügbarkeit erfolgreich geprüft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                },
                "examples": {
                  "available": {
                    "summary": "Zimmer verfügbar",
                    "value": {
                      "roomId": 1,
                      "roomTitle": "Deluxe Suite",
                      "checkIn": "2026-07-01",
                      "checkOut": "2026-07-05",
                      "available": true,
                      "nights": 4,
                      "totalPrice": 596.0
                    }
                  },
                  "notAvailable": {
                    "summary": "Zimmer nicht verfügbar",
                    "value": {
                      "roomId": 1,
                      "roomTitle": "Deluxe Suite",
                      "checkIn": "2026-07-01",
                      "checkOut": "2026-07-05",
                      "available": false,
                      "nights": 4,
                      "totalPrice": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Buchung erstellen",
        "description": "Erstellt eine neue Buchung für ein verfügbares Zimmer.\n\n**Validierungsregeln:**\n- `firstName`: nicht leer, max. 100 Zeichen\n- `lastName`: nicht leer, max. 100 Zeichen\n- `email`: gültiges E-Mail-Format\n- `roomId`: muss existierendes Zimmer referenzieren\n- `checkIn` darf nicht in der Vergangenheit liegen\n- `checkOut` muss nach `checkIn` liegen\n- Maximaler Buchungszeitraum: 30 Nächte\n- Zimmer muss im gewählten Zeitraum verfügbar sein",
        "operationId": "createBooking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              },
              "example": {
                "roomId": 1,
                "checkIn": "2026-07-01",
                "checkOut": "2026-07-05",
                "firstName": "Max",
                "lastName": "Mustermann",
                "email": "max@example.com",
                "breakfast": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Buchung erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                },
                "example": {
                  "id": "a3f1c2d4-e5b6-7890-abcd-ef1234567890",
                  "room": {
                    "id": 1,
                    "title": "Deluxe Suite",
                    "description": "Geräumige Suite mit Balkon und Bergblick.",
                    "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                    "pricePerNight": 149.0,
                    "extras": [
                      {
                        "id": 1,
                        "name": "WiFi",
                        "icon": "wifi"
                      }
                    ],
                    "availability": null
                  },
                  "checkIn": "2026-07-01",
                  "checkOut": "2026-07-05",
                  "nights": 4,
                  "firstName": "Max",
                  "lastName": "Mustermann",
                  "email": "max@example.com",
                  "totalPrice": 626.0,
                  "status": "CONFIRMED",
                  "createdAt": "2026-05-04T14:30:00Z",
                  "breakfast": true
                }
              }
            }
          },
          "400": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "timestamp": "2026-05-04T14:30:00Z",
                  "status": 400,
                  "error": "Bad Request",
                  "message": "Validation failed",
                  "fieldErrors": [
                    {
                      "field": "email",
                      "message": "must be a valid email address"
                    }
                  ],
                  "path": "/api/v1/bookings"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Buchungsbestätigung abrufen",
        "description": "Gibt die vollständige Buchungsbestätigung zurück inkl. Hotelinformationen.",
        "operationId": "getBookingById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID der Buchung",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buchung gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingConfirmation"
                },
                "example": {
                  "id": "a3f1c2d4-e5b6-7890-abcd-ef1234567890",
                  "room": {
                    "id": 1,
                    "title": "Deluxe Suite",
                    "description": "Geräumige Suite mit Balkon und Bergblick.",
                    "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                    "pricePerNight": 149.0,
                    "extras": [
                      {
                        "id": 1,
                        "name": "WiFi",
                        "icon": "wifi"
                      }
                    ],
                    "availability": null
                  },
                  "checkIn": "2026-07-01",
                  "checkOut": "2026-07-05",
                  "nights": 4,
                  "firstName": "Max",
                  "lastName": "Mustermann",
                  "email": "max@example.com",
                  "totalPrice": 626.0,
                  "status": "CONFIRMED",
                  "createdAt": "2026-05-04T14:30:00Z",
                  "hotel": {
                    "name": "Boutique Hotel Technikum",
                    "address": "Höchstädtplatz 6, 1200 Wien",
                    "phone": "+43 1 XXXXXXX",
                    "email": "info@hotel-technikum.at",
                    "directions": "U6 Station Dresdner Straße, 2 Minuten Fußweg",
                    "coordinates": {
                      "lat": 48.2392,
                      "lng": 16.378
                    }
                  },
                  "breakfast": true
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Bookings"
        ],
        "summary": "Buchung stornieren",
        "description": "Storniert eine bestehende Buchung. Eine bereits stornierte Buchung kann nicht erneut storniert werden (409).",
        "operationId": "cancelBooking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID der Buchung",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buchung erfolgreich storniert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingConfirmation"
                },
                "example": {
                  "id": "a3f1c2d4-e5b6-7890-abcd-ef1234567890",
                  "room": {
                    "id": 1,
                    "title": "Deluxe Suite",
                    "description": "Geräumige Suite mit Balkon und Bergblick.",
                    "imageUrl": "https://hotel-technikum.at/images/rooms/1.jpg",
                    "pricePerNight": 149.0,
                    "extras": [
                      {
                        "id": 1,
                        "name": "WiFi",
                        "icon": "wifi"
                      }
                    ],
                    "availability": null
                  },
                  "checkIn": "2026-07-01",
                  "checkOut": "2026-07-05",
                  "nights": 4,
                  "firstName": "Max",
                  "lastName": "Mustermann",
                  "email": "max@example.com",
                  "totalPrice": 626.0,
                  "status": "CANCELLED",
                  "createdAt": "2026-05-04T14:30:00Z",
                  "hotel": {
                    "name": "Boutique Hotel Technikum",
                    "address": "Höchstädtplatz 6, 1200 Wien",
                    "phone": "+43 1 XXXXXXX",
                    "email": "info@hotel-technikum.at",
                    "directions": "U6 Station Dresdner Straße, 2 Minuten Fußweg",
                    "coordinates": {
                      "lat": 48.2392,
                      "lng": 16.378
                    }
                  },
                  "breakfast": true
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Buchung ist bereits storniert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "timestamp": "2026-05-04T14:30:00Z",
                  "status": 409,
                  "error": "Conflict",
                  "message": "Booking is already cancelled",
                  "path": "/api/v1/bookings/a3f1c2d4-e5b6-7890-abcd-ef1234567890"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Extra": {
        "type": "object",
        "description": "Zimmer-Ausstattungsmerkmal",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "WiFi"
          },
          "icon": {
            "type": "string",
            "example": "wifi"
          }
        },
        "required": [
          "id",
          "name",
          "icon"
        ]
      },
      "RoomAvailabilitySummary": {
        "type": "object",
        "description": "Eingebettete Verfügbarkeitsinfo – nur gesetzt wenn GET /rooms mit checkIn/checkOut aufgerufen wurde",
        "properties": {
          "available": {
            "type": "boolean",
            "example": true
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Gesamtpreis in EUR. Null wenn nicht verfügbar.",
            "example": 596.0
          }
        },
        "required": [
          "available",
          "nights"
        ]
      },
      "Room": {
        "type": "object",
        "description": "Hotelzimmer",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Deluxe Suite"
          },
          "description": {
            "type": "string",
            "example": "Geräumige Suite mit Balkon und Bergblick."
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Absolute URL zum Zimmerbild",
            "example": "https://hotel-technikum.at/images/rooms/1.jpg"
          },
          "pricePerNight": {
            "type": "number",
            "format": "double",
            "example": 149.0
          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Extra"
            }
          },
          "availability": {
            "nullable": true,
            "description": "Nur befüllt wenn GET /rooms mit checkIn und checkOut aufgerufen wurde. Sonst null.",
            "allOf": [
              {
                "$ref": "#/components/schemas/RoomAvailabilitySummary"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "imageUrl",
          "pricePerNight",
          "extras"
        ]
      },
      "RoomPage": {
        "type": "object",
        "description": "Paginierte Liste von Hotelzimmern",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          },
          "totalElements": {
            "type": "integer",
            "example": 12
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          },
          "currentPage": {
            "type": "integer",
            "example": 0
          },
          "hasNextPage": {
            "type": "boolean",
            "example": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "content",
          "totalElements",
          "totalPages",
          "currentPage",
          "hasNextPage",
          "hasPreviousPage"
        ]
      },
      "AvailabilityResponse": {
        "type": "object",
        "description": "Ergebnis der Verfügbarkeitsprüfung",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "roomTitle": {
            "type": "string",
            "example": "Deluxe Suite"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-07-05"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Gesamtpreis in EUR. Null wenn Zimmer nicht verfügbar.",
            "example": 596.0
          }
        },
        "required": [
          "roomId",
          "roomTitle",
          "checkIn",
          "checkOut",
          "available",
          "nights"
        ]
      },
      "BookingRequest": {
        "type": "object",
        "description": "Anfrage zur Erstellung einer Buchung. Der totalPrice wird vom Backend berechnet und beinhaltet ggf. den Frühstücksaufpreis.",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "description": "Muss nach checkIn liegen. Maximaler Zeitraum: 30 Nächte.",
            "example": "2026-07-05"
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "example": "Max"
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "example": "Mustermann"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "max@example.com"
          },
          "breakfast": {
            "type": "boolean",
            "description": "Frühstück gewünscht. Beeinflusst den totalPrice – der genaue Aufpreis wird vom Backend berechnet.",
            "example": true
          }
        },
        "required": [
          "roomId",
          "checkIn",
          "checkOut",
          "firstName",
          "lastName",
          "email",
          "breakfast"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "description": "Status der Buchung",
        "enum": [
          "CONFIRMED",
          "CANCELLED"
        ],
        "example": "CONFIRMED"
      },
      "BookingResponse": {
        "type": "object",
        "description": "Erstellte oder abgerufene Buchung",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Eindeutige UUID der Buchung",
            "example": "a3f1c2d4-e5b6-7890-abcd-ef1234567890"
          },
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-07-05"
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "firstName": {
            "type": "string",
            "example": "Max"
          },
          "lastName": {
            "type": "string",
            "example": "Mustermann"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "max@example.com"
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "description": "Gesamtpreis in EUR inkl. Frühstücksaufpreis wenn gebucht.",
            "example": 596.0
          },
          "breakfast": {
            "type": "boolean",
            "description": "Gibt an ob Frühstück gebucht wurde.",
            "example": true
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Erstellungszeitpunkt der Buchung. Immer in UTC (Z).",
            "example": "2026-05-04T14:30:00Z"
          }
        },
        "required": [
          "id",
          "room",
          "checkIn",
          "checkOut",
          "nights",
          "firstName",
          "lastName",
          "email",
          "totalPrice",
          "breakfast",
          "status",
          "createdAt"
        ]
      },
      "HotelCoordinates": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "format": "double",
            "example": 48.2392
          },
          "lng": {
            "type": "number",
            "format": "double",
            "example": 16.378
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "HotelInfo": {
        "type": "object",
        "description": "Hotelinformationen für die Buchungsbestätigung",
        "properties": {
          "name": {
            "type": "string",
            "example": "Boutique Hotel Technikum"
          },
          "address": {
            "type": "string",
            "example": "Höchstädtplatz 6, 1200 Wien"
          },
          "phone": {
            "type": "string",
            "example": "+43 1 XXXXXXX"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "info@hotel-technikum.at"
          },
          "directions": {
            "type": "string",
            "example": "U6 Station Dresdner Straße, 2 Minuten Fußweg"
          },
          "coordinates": {
            "$ref": "#/components/schemas/HotelCoordinates"
          }
        },
        "required": [
          "name",
          "address",
          "phone",
          "email",
          "directions",
          "coordinates"
        ]
      },
      "BookingConfirmation": {
        "description": "Vollständige Buchungsbestätigung inkl. Hotelinformationen",
        "allOf": [
          {
            "$ref": "#/components/schemas/BookingResponse"
          },
          {
            "type": "object",
            "properties": {
              "hotel": {
                "$ref": "#/components/schemas/HotelInfo"
              }
            },
            "required": [
              "hotel"
            ]
          }
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Einheitliches Fehlerformat",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fehlerzeitpunkt in UTC",
            "example": "2026-05-04T14:30:00Z"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "checkOut must be after checkIn"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/rooms/1/availability"
          }
        },
        "required": [
          "timestamp",
          "status",
          "error",
          "message",
          "path"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "must be a valid email address"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ValidationError": {
        "description": "Validierungsfehler mit Felddetails",
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiError"
          },
          {
            "type": "object",
            "properties": {
              "fieldErrors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              }
            }
          }
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültige Anfrage (Validierungsfehler)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 400,
              "error": "Bad Request",
              "message": "checkOut must be after checkIn",
              "path": "/api/v1/rooms/1/availability"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 404,
              "error": "Not Found",
              "message": "Room not found",
              "path": "/api/v1/rooms/99"
            }
          }
        }
      },
      "Conflict": {
        "description": "Zimmer im gewünschten Zeitraum bereits gebucht",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 409,
              "error": "Conflict",
              "message": "Room is no longer available for the selected dates",
              "path": "/api/v1/bookings"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Interner Serverfehler",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 500,
              "error": "Internal Server Error",
              "message": "An unexpected error occurred",
              "path": "/api/v1/rooms"
            }
          }
        }
      }
    }
  }
}