{
  "openapi": "3.0.3",
  "info": {
    "title": "Boutique Hotel Technikum – Booking API",
    "description": "REST API für die Buchungs-App des Hotel Technikum. Gäste können Hotelzimmer durchsuchen, Verfügbarkeit prüfen und Zimmer buchen.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Rooms",
      "description": "Hotelzimmer durchsuchen und Details abrufen (U2)"
    },
    {
      "name": "Availability",
      "description": "Zimmerverfügbarkeit prüfen (U3)"
    },
    {
      "name": "Bookings",
      "description": "Buchungen erstellen und abrufen (U4, U5)"
    }
  ],
  "paths": {
    "/rooms": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Paginierte Zimmerliste",
        "description": "Gibt eine paginierte Liste aller Hotelzimmer zurück. Standardmäßig 5 Zimmer pro Seite.",
        "operationId": "getRooms",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Seitennummer (0-basiert)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Anzahl Zimmer pro Seite",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolgreiche Anfrage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomPage"
                },
                "example": {
                  "content": [
                    {
                      "id": 1,
                      "title": "Deluxe Suite",
                      "description": "Geräumige Suite mit Balkon und Bergblick.",
                      "image": "/images/rooms/1.jpg",
                      "pricePerNight": 149.0,
                      "extras": [
                        { "id": 1, "name": "WiFi", "icon": "wifi" },
                        { "id": 2, "name": "Minibar", "icon": "cup-hot" },
                        { "id": 3, "name": "Balkon", "icon": "door-open" }
                      ]
                    }
                  ],
                  "totalElements": 12,
                  "totalPages": 3,
                  "currentPage": 0,
                  "pageSize": 5
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rooms/{id}": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Zimmerdetails",
        "description": "Gibt die Details eines einzelnen Zimmers zurück.",
        "operationId": "getRoomById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID des Hotelzimmers",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Zimmer gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                },
                "example": {
                  "id": 1,
                  "title": "Deluxe Suite",
                  "description": "Geräumige Suite mit Balkon und Bergblick.",
                  "image": "/images/rooms/1.jpg",
                  "pricePerNight": 149.0,
                  "extras": [
                    { "id": 1, "name": "WiFi", "icon": "wifi" },
                    { "id": 2, "name": "Minibar", "icon": "cup-hot" },
                    { "id": 3, "name": "Balkon", "icon": "door-open" }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rooms/{id}/availability": {
      "get": {
        "tags": ["Availability"],
        "summary": "Verfügbarkeit prüfen",
        "description": "Prüft, ob ein bestimmtes Zimmer im gewünschten Zeitraum verfügbar ist.\n\n**Validierungsregeln:**\n- `checkIn` darf nicht in der Vergangenheit liegen\n- `checkOut` muss nach `checkIn` liegen\n- Maximaler Buchungszeitraum: 30 Nächte",
        "operationId": "checkRoomAvailability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID des Hotelzimmers",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "checkIn",
            "in": "query",
            "description": "Anreisedatum (Format: YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-01"
            }
          },
          {
            "name": "checkOut",
            "in": "query",
            "description": "Abreisedatum (Format: YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-05"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verfügbarkeit erfolgreich geprüft (Zimmer kann verfügbar oder nicht verfügbar sein)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                },
                "examples": {
                  "available": {
                    "summary": "Zimmer verfügbar",
                    "value": {
                      "roomId": 1,
                      "roomTitle": "Deluxe Suite",
                      "checkIn": "2026-07-01",
                      "checkOut": "2026-07-05",
                      "available": true,
                      "nights": 4,
                      "totalPrice": 596.0
                    }
                  },
                  "notAvailable": {
                    "summary": "Zimmer nicht verfügbar",
                    "value": {
                      "roomId": 1,
                      "roomTitle": "Deluxe Suite",
                      "checkIn": "2026-07-01",
                      "checkOut": "2026-07-05",
                      "available": false,
                      "nights": 4,
                      "totalPrice": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "tags": ["Bookings"],
        "summary": "Buchung erstellen",
        "description": "Erstellt eine neue Buchung für ein verfügbares Zimmer.\n\n**Validierungsregeln:**\n- `firstName`: nicht leer, max. 100 Zeichen\n- `lastName`: nicht leer, max. 100 Zeichen\n- `email`: gültiges E-Mail-Format\n- `emailConfirm`: muss mit `email` übereinstimmen\n- `breakfast`: boolean, Pflichtfeld\n- `roomId`: muss existierendes Zimmer referenzieren\n- `checkIn` / `checkOut`: gültig, Zimmer muss im Zeitraum verfügbar sein",
        "operationId": "createBooking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              },
              "example": {
                "roomId": 1,
                "checkIn": "2026-07-01",
                "checkOut": "2026-07-05",
                "firstName": "Max",
                "lastName": "Mustermann",
                "email": "max@example.com",
                "emailConfirm": "max@example.com",
                "breakfast": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Buchung erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                },
                "example": {
                  "id": 42,
                  "room": {
                    "id": 1,
                    "title": "Deluxe Suite",
                    "description": "Geräumige Suite mit Balkon und Bergblick.",
                    "image": "/images/rooms/1.jpg",
                    "pricePerNight": 149.0,
                    "extras": [{ "id": 1, "name": "WiFi", "icon": "wifi" }]
                  },
                  "checkIn": "2026-07-01",
                  "checkOut": "2026-07-05",
                  "nights": 4,
                  "breakfast": true,
                  "firstName": "Max",
                  "lastName": "Mustermann",
                  "email": "max@example.com",
                  "totalPrice": 596.0,
                  "createdAt": "2026-05-04T14:30:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "timestamp": "2026-05-04T14:30:00Z",
                  "status": 400,
                  "error": "Bad Request",
                  "message": "Validation failed",
                  "fieldErrors": [
                    { "field": "email", "message": "must be a valid email address" },
                    { "field": "emailConfirm", "message": "email addresses do not match" }
                  ],
                  "path": "/api/v1/bookings"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Buchungsbestätigung abrufen",
        "description": "Gibt die vollständige Buchungsbestätigung zurück inkl. Hotelinformationen.",
        "operationId": "getBookingById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID der Buchung",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buchung gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingConfirmation"
                },
                "example": {
                  "id": 42,
                  "room": {
                    "id": 1,
                    "title": "Deluxe Suite",
                    "description": "Geräumige Suite mit Balkon und Bergblick.",
                    "image": "/images/rooms/1.jpg",
                    "pricePerNight": 149.0,
                    "extras": [{ "id": 1, "name": "WiFi", "icon": "wifi" }]
                  },
                  "checkIn": "2026-07-01",
                  "checkOut": "2026-07-05",
                  "nights": 4,
                  "breakfast": true,
                  "firstName": "Max",
                  "lastName": "Mustermann",
                  "email": "max@example.com",
                  "totalPrice": 596.0,
                  "createdAt": "2026-05-04T14:30:00Z",
                  "hotel": {
                    "name": "Boutique Hotel Technikum",
                    "address": "Höchstädtplatz 6, 1200 Wien",
                    "phone": "+43 1 XXXXXXX",
                    "email": "info@hotel-technikum.at",
                    "directions": "U6 Station Dresdner Straße, 2 Minuten Fußweg",
                    "coordinates": {
                      "lat": 48.2392,
                      "lng": 16.378
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Extra": {
        "type": "object",
        "description": "Zimmer-Ausstattungsmerkmal",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "WiFi"
          },
          "icon": {
            "type": "string",
            "example": "wifi"
          }
        },
        "required": ["id", "name", "icon"]
      },
      "Room": {
        "type": "object",
        "description": "Hotelzimmer",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Deluxe Suite"
          },
          "description": {
            "type": "string",
            "example": "Geräumige Suite mit Balkon und Bergblick."
          },
          "image": {
            "type": "string",
            "example": "/images/rooms/1.jpg"
          },
          "pricePerNight": {
            "type": "number",
            "format": "double",
            "example": 149.0
          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Extra"
            }
          }
        },
        "required": ["id", "title", "description", "image", "pricePerNight", "extras"]
      },
      "RoomPage": {
        "type": "object",
        "description": "Paginierte Liste von Hotelzimmern",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          },
          "totalElements": {
            "type": "integer",
            "example": 12
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          },
          "currentPage": {
            "type": "integer",
            "example": 0
          },
          "pageSize": {
            "type": "integer",
            "example": 5
          }
        },
        "required": ["content", "totalElements", "totalPages", "currentPage", "pageSize"]
      },
      "AvailabilityResponse": {
        "type": "object",
        "description": "Ergebnis der Verfügbarkeitsprüfung",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "roomTitle": {
            "type": "string",
            "example": "Deluxe Suite"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-07-05"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Gesamtpreis in EUR. Null wenn Zimmer nicht verfügbar.",
            "example": 596.0
          }
        },
        "required": ["roomId", "roomTitle", "checkIn", "checkOut", "available", "nights"]
      },
      "BookingRequest": {
        "type": "object",
        "description": "Anfrage zur Erstellung einer Buchung",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-07-05"
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "example": "Max"
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "example": "Mustermann"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "max@example.com"
          },
          "emailConfirm": {
            "type": "string",
            "format": "email",
            "description": "Muss mit dem Feld `email` übereinstimmen",
            "example": "max@example.com"
          },
          "breakfast": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "roomId",
          "checkIn",
          "checkOut",
          "firstName",
          "lastName",
          "email",
          "emailConfirm",
          "breakfast"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "description": "Erstellte Buchung",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 42
          },
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-07-05"
          },
          "nights": {
            "type": "integer",
            "example": 4
          },
          "breakfast": {
            "type": "boolean",
            "example": true
          },
          "firstName": {
            "type": "string",
            "example": "Max"
          },
          "lastName": {
            "type": "string",
            "example": "Mustermann"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "max@example.com"
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "example": 596.0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-04T14:30:00Z"
          }
        },
        "required": [
          "id", "room", "checkIn", "checkOut", "nights",
          "breakfast", "firstName", "lastName", "email", "totalPrice", "createdAt"
        ]
      },
      "HotelCoordinates": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "format": "double",
            "example": 48.2392
          },
          "lng": {
            "type": "number",
            "format": "double",
            "example": 16.378
          }
        },
        "required": ["lat", "lng"]
      },
      "HotelInfo": {
        "type": "object",
        "description": "Hotelinformationen für die Buchungsbestätigung",
        "properties": {
          "name": {
            "type": "string",
            "example": "Boutique Hotel Technikum"
          },
          "address": {
            "type": "string",
            "example": "Höchstädtplatz 6, 1200 Wien"
          },
          "phone": {
            "type": "string",
            "example": "+43 1 XXXXXXX"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "info@hotel-technikum.at"
          },
          "directions": {
            "type": "string",
            "example": "U6 Station Dresdner Straße, 2 Minuten Fußweg"
          },
          "coordinates": {
            "$ref": "#/components/schemas/HotelCoordinates"
          }
        },
        "required": ["name", "address", "phone", "email", "directions", "coordinates"]
      },
      "BookingConfirmation": {
        "description": "Vollständige Buchungsbestätigung inkl. Hotelinformationen",
        "allOf": [
          { "$ref": "#/components/schemas/BookingResponse" },
          {
            "type": "object",
            "properties": {
              "hotel": {
                "$ref": "#/components/schemas/HotelInfo"
              }
            },
            "required": ["hotel"]
          }
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Einheitliches Fehlerformat",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-04T14:30:00Z"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "checkOut must be after checkIn"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/rooms/1/availability"
          }
        },
        "required": ["timestamp", "status", "error", "message", "path"]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "must be a valid email address"
          }
        },
        "required": ["field", "message"]
      },
      "ValidationError": {
        "description": "Validierungsfehler mit Felddetails",
        "allOf": [
          { "$ref": "#/components/schemas/ApiError" },
          {
            "type": "object",
            "properties": {
              "fieldErrors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              }
            }
          }
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültige Anfrage (Validierungsfehler)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 400,
              "error": "Bad Request",
              "message": "checkOut must be after checkIn",
              "path": "/api/v1/rooms/1/availability"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 404,
              "error": "Not Found",
              "message": "Room not found",
              "path": "/api/v1/rooms/99"
            }
          }
        }
      },
      "Conflict": {
        "description": "Zimmer im gewünschten Zeitraum bereits gebucht",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 409,
              "error": "Conflict",
              "message": "Room is no longer available for the selected dates",
              "path": "/api/v1/bookings"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Interner Serverfehler",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "timestamp": "2026-05-04T14:30:00Z",
              "status": 500,
              "error": "Internal Server Error",
              "message": "An unexpected error occurred",
              "path": "/api/v1/rooms"
            }
          }
        }
      }
    }
  }
}
